# Public-source allowlist. New top-level items stay private until reviewed.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.editorconfig
!/.env.example
!/.publication-policy.json
!/.gitleaks.toml
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/Directory.Build.props
!/PersonalBrand.sln
!/dotnet-tools.json
!/docker-compose.yml
!/.github/
!/.githooks/
!/src/
!/tests/
!/docs/
!/tools/

# Internal delivery material and one-off maintenance tools are not source.
/docs/*
!/docs/ARCHITECTURE.md
!/docs/WORKSHOP-RESERVATION.md
!/docs/AUDIENCE-AND-CONSENT.md
!/docs/ADMIN-GUIDE.md
!/docs/SAFE-PUBLISHING.md
/tools/*
!/tools/Initialize-Repository.ps1
!/tools/Install-Gitleaks.ps1
!/tools/Test-Publication.ps1
!/tools/Test-PublicationGuards.ps1
!/tools/Publish.ps1

# Local data, accounts, secrets, credentials, and generated artifacts (at any depth).
**/bin/
**/obj/
**/App_Data/
**/TestResults/
**/uploads/
**/receipts/
**/backups/
**/logs/
**/.vs/
**/.idea/
