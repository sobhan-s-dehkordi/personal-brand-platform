@page "/{culture:regex(^(en|fa)$)}"
@model HomeModel
@inject PersonalBrand.Infrastructure.SafeMarkdown Markdown
@{
    ViewData["Title"] = Model.Text("Home.Title");
}
<section class="hero">
    <span class="eyebrow">
        @Model.Text("Home.Eyebrow")</span>
    <h1>
        @Model.Text("Home.Heading")
        <br/>
        <span>
            @Model.Text("Home.Highlight")</span>
    </h1>
    <div class="lead prose">
        @Html.Raw(Markdown.Render(Model.Text("Brand.ShortBio")))</div>
    <div class="actions">
        <a class="btn btn-dark" href="/@Model.Culture/projects">
            @Model.Text("Home.ProjectsButton")</a>
        <a href="/@Model.Culture/articles">
            @Model.Text("Home.ArticlesButton")</a>
        <a href="/@Model.Culture/resume">
            @Model.Text("Home.ResumeButton")</a>
    </div>
    <div class="hero-note">
        @Model.Text("Brand.ProfessionalTitle") · @Model.Text("Home.Note")</div>
</section>
@foreach (var section in Model.Fa ? new[] { "articles", "workshops", "courses", "projects" } : new[] { "projects", "articles", "courses", "workshops" })
{
    IEnumerable<PersonalBrand.Core.Content> items = section switch
    {
        "projects" => Model.Projects,
        "articles" => Model.Articles,
        "courses" => Model.Courses,
        _ => Model.Workshops
    };
    <section class="section">
        <div class="section-heading">
            <h2>
                @Model.Text("Navigation." + section)</h2>
            <a href="/@Model.Culture/@(section)">
                @Model.Text("Home.ViewAll")</a>
        </div>
        <div class="cards">
            @foreach (var item in items)
            {
                <article class="content-card">
                    <span class="eyebrow">
                        @Model.Text("Navigation." + section)</span>
                    <h3>
                        <a href="/@Model.Culture/@(section)/@item.Slug">
                            @item.Title</a>
                    </h3>
                    <div class="prose">
                        @Html.Raw(Markdown.Render(item.Summary))</div>
                    <span class="card-arrow" aria-hidden="true">↗</span>
                </article>
            }
            @if (!items.Any())
            {
                <div class="prose empty-message">
                    @Html.Raw(Markdown.Render(Model.Text("Home.Empty")))</div>
            }
        </div>
    </section>
}
<section class="section">
    <span class="eyebrow">
        @Model.Text("Home.AboutEyebrow")</span>
    <h2>
        @Model.Text("Home.AboutHeading")</h2>
    <div class="lead prose">
        @Html.Raw(Markdown.Render(Model.Text("Home.AboutBody")))</div>
    <div class="actions">
        <a href="/@Model.Culture/about">
            @Model.Text("Home.AboutButton")</a>
        @foreach (var network in new[] { "GitHub", "LinkedIn", "YouTube" })
        {
            var url = Model.Text("Brand." + network + "Url");
            @if (!string.IsNullOrWhiteSpace(url))
            {
                <a href="@url">
                    @Model.Text("Social." + network)</a>
            }
        }
    </div>
</section>
<section class="newsletter">
    <h2>
        @Model.Text("Home.NewsletterHeading")</h2>
    <div class="prose">
        @Html.Raw(Markdown.Render(Model.Text("Home.NewsletterBody")))</div>
    <form method="post">
        <div asp-validation-summary="All">
        </div>
        <label asp-for="Input.FullName">
            @Model.Text("Home.NameLabel")</label>
        <input asp-for="Input.FullName" autocomplete="name"/>
        <label asp-for="Input.Email">
            @Model.Text("Home.EmailLabel")</label>
        <input asp-for="Input.Email" autocomplete="email"/>
        <label class="check">
            <input asp-for="Input.MarketingConsent"/> @Model.Text("Home.Consent")</label>
        <button class="btn btn-dark">
            @Model.Text("Home.Subscribe")</button>
        <a href="/@Model.Culture/privacy">
            @Model.Text("Navigation.privacy")</a>
    </form>
</section>
