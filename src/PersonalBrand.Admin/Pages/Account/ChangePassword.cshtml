@page
@model PersonalBrand.Admin.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}
<section class="reading">
    <h1>Change password</h1>
    <p>Use at least 12 characters, including uppercase and lowercase letters, a number, and a symbol.</p>
    <form method="post">
        <div asp-validation-summary="All">
        </div>
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" autocomplete="current-password"/>
        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" autocomplete="new-password"/>
        <label asp-for="ConfirmPassword">Confirm new password</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password"/>
        <button class="btn btn-dark">Change password</button>
    </form>
</section>
